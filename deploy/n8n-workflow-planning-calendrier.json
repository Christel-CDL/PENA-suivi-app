    {
      "id": "code_diff",
      "name": "Calcule les nouveaux jours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "const METAUX_ID = 'recagFquBCz04FJfi';\nconst ENV_ID = 'recA9nSrxiyq1Ta9x';\n\nconst calendarEvents = $('Lit le calendrier').first().json.value || [];\nconst existingRecords = $json.records || [];\n\nconst existingKeys = new Set();\nfor (const r of existingRecords) {\n  const d = r.fields && r.fields['fldEudIIzKQYXdh1b'];\n  const sites = (r.fields && r.fields['fldkSCBcG0xkGoIkD']) || [];\n  for (const s of sites) existingKeys.add(d + '|' + s);\n}\n\nconst newRecords = [];\nconst seen = new Set();\n\nfor (const ev of calendarEvents) {\n  const subject = ev.subject || '';\n  const upper = subject.toUpperCase();\n\n  // Seuls les evenements \"journee sur site\" comptent ici (ex. \"Journee PENA\") --\n  // un rendez-vous ponctuel qui mentionne juste PENA dans son titre ne doit pas\n  // creer un jour de planning (voir echange avec Christel du 11/09).\n  const isJourneeSite = upper.includes('JOURNEE') || upper.includes('JOURN\\u00c9E');\n  if (!isJourneeSite) continue;\n\n  let siteId = null;\n  if (/\\bPE\\b/.test(upper)) siteId = ENV_ID;\n  else if (/\\bPM\\b/.test(upper) || /\\bPL\\b/.test(upper) || /\\bPENA\\b/.test(upper)) siteId = METAUX_ID;\n  if (!siteId) continue;\n\n  const date = ((ev.start && ev.start.dateTime) || '').slice(0, 10);\n  if (!date) continue;\n\n  const key = date + '|' + siteId;\n  if (seen.has(key) || existingKeys.has(key)) continue;\n  seen.add(key);\n\n  newRecords.push({\n    fields: {\n      fldYJwPLx9iyTfjLR: subject,\n      fldEudIIzKQYXdh1b: date,\n      fldkSCBcG0xkGoIkD: [siteId],\n    },\n  });\n}\n\nif (newRecords.length === 0) return [];\nreturn [{ json: { records: newRecords } }];"
      }
    },
    {
      "id": "http_write_new",
      "name": "Ecrit les nouveaux jours",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/app6sehe4hMHO1NXe/tble9ApzEooaJNyw3?returnFieldsByFieldId=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { records: $json.records } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "IMXxSWZ9pMZm3U0q",
          "name": "Airtable PENA (header)"
        }
      }
    }
  ],
