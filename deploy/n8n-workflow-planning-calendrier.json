    {
      "id": "http_list_existing",
      "name": "Liste les jours existants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/app6sehe4hMHO1NXe/tble9ApzEooaJNyw3",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "returnFieldsByFieldId", "value": "true" },
            { "name": "fields[]", "value": "fldEudIIzKQYXdh1b" },
            { "name": "fields[]", "value": "fldkSCBcG0xkGoIkD" }
          ]
        },
        "options": {}
      },
